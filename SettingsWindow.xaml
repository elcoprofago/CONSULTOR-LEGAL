<Window x:Class="ConsultorLegal.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Icon="balanza5.ico" Background="#FF1A1A1A"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <!-- ===================== Fondo de ventana ===================== -->
        <TextBlock Text="Fondo de ventana" Style="{StaticResource SectionHeader}"/>
        <Border Background="{StaticResource PanelBg}" CornerRadius="4" Padding="10" Margin="0,6,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbTemaClaro" Content="Blanco" GroupName="Tema" Margin="0,0,14,0" Checked="Tema_Changed"/>
                    <RadioButton x:Name="RbTemaOscuro" Content="Oscuro" GroupName="Tema" Margin="0,0,14,0" Checked="Tema_Changed"/>
                    <RadioButton x:Name="RbTemaTextura" Content="Con textura" GroupName="Tema" Checked="Tema_Changed"/>
                </StackPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtRutaTextura" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center"
                             ToolTip="Imagen que se repite en mosaico como fondo"/>
                    <Button x:Name="BtnExaminarTextura" Grid.Column="1" Content="Examinar..." Margin="6,0,0,0"
                            Click="BtnExaminarTextura_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== Exportación ===================== -->
        <TextBlock Text="Exportación" Style="{StaticResource SectionHeader}"/>
        <Border Background="{StaticResource PanelBg}" CornerRadius="4" Padding="10" Margin="0,6,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Formato por defecto" Foreground="{StaticResource TextDim}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbTxt" Content="TXT" GroupName="Formato" Margin="0,0,14,0"/>
                    <RadioButton x:Name="RbDocx" Content="DOCX" GroupName="Formato"/>
                </StackPanel>
                <TextBlock Text="Carpeta por defecto" Foreground="{StaticResource TextDim}" Margin="0,8,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtCarpeta" Grid.Column="0" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnExaminarCarpeta" Grid.Column="1" Content="Examinar..." Margin="6,0,0,0"
                            Click="BtnExaminarCarpeta_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== Interfaz ===================== -->
        <TextBlock Text="Interfaz" Style="{StaticResource SectionHeader}"/>
        <Border Background="{StaticResource PanelBg}" CornerRadius="4" Padding="10" Margin="0,6,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tamaño de letra de los resultados" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider x:Name="SldFuente" Minimum="10" Maximum="22" Width="180" TickFrequency="1"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SldFuente_ValueChanged"/>
                <TextBlock x:Name="TxtFuente" Width="30" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ===================== Actualización ===================== -->
        <TextBlock Text="Actualización" Style="{StaticResource SectionHeader}"/>
        <Border Background="{StaticResource PanelBg}" CornerRadius="4" Padding="10" Margin="0,6,0,14">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="BtnActualizar" DockPanel.Dock="Right" Content="Buscar actualización" Padding="10,4"
                            Margin="8,0,0,0" Click="BtnActualizar_Click"
                            ToolTip="Busca en GitHub (elcoprofago/CONSULTOR-LEGAL) si hay una versión más nueva y la instala"/>
                    <TextBlock x:Name="TxtVersion" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                </DockPanel>
                <TextBlock x:Name="TxtEstadoActualizacion" Margin="0,6,0,0" Foreground="{StaticResource TextDim}" FontStyle="Italic"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Guardar" Style="{StaticResource ConsultarButtonStyle}" Click="BtnGuardar_Click" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
