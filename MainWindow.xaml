<Window x:Class="ConsultorLegal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ConsultorLegal"
        Title="CONSULTOR-LEGAL" Icon="balanza5.ico"
        Background="#FF1A1A1A" Width="1600" Height="1000" MinWidth="900" MinHeight="600"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== FILA 0: conexión + rendimiento ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="BorderConexion" Grid.Column="0" Background="{StaticResource PanelBg}"
                    CornerRadius="4" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Servidor MCP" Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtEndpoint" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center"
                             ToolTip="Dirección del servidor MCP de bravo47. Cambiala solo si publican una versión nueva (por ejemplo /v6/mcp)."
                             TextChanged="TxtEndpoint_TextChanged" KeyDown="TxtEndpoint_KeyDown"/>
                    <Button x:Name="BtnConectar" Grid.Row="0" Grid.Column="2" Content="Conectar" Margin="6,0,6,0"
                            Click="BtnConectar_Click"
                            ToolTip="Conecta con el servidor y carga la lista de herramientas disponibles"/>
                    <Button x:Name="BtnRestaurarEndpoint" Grid.Row="0" Grid.Column="3" Content="↺" Margin="0"
                            Click="BtnRestaurarEndpoint_Click" ToolTip="Volver a la dirección por defecto"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Claude Code" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" Margin="0,8,10,0"/>
                    <TextBox x:Name="TxtComando" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,8,0,0"
                             FontFamily="Consolas" VerticalContentAlignment="Center"
                             ToolTip="Comando para sumar este servidor a Claude Code (en VSCode o en la terminal). Se pega una sola vez."/>
                    <Button x:Name="BtnCopiarComando" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Copiar comando"
                            Margin="6,8,0,0" Click="BtnCopiarComando_Click"
                            ToolTip="Copia el comando al portapapeles para pegarlo en una terminal"/>

                    <TextBlock x:Name="TxtEstadoServidor" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0"
                               Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Text="Sin conectar."/>
                </Grid>
            </Border>

            <Border x:Name="BorderPerf" Grid.Column="1" Background="{StaticResource PanelBg}"
                    CornerRadius="4" Padding="10">
                <StackPanel Orientation="Horizontal"
                            ToolTip="Recursos que consume esta aplicación. Las consultas se resuelven en el servidor de bravo47, no en esta PC.">
                    <StackPanel Orientation="Vertical" Margin="6,0">
                        <TextBlock Text="RAM" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="10"/>
                        <local:PerfCircle x:Name="CircleRam"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="6,0">
                        <TextBlock Text="CPU" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="10"/>
                        <local:PerfCircle x:Name="CircleCpu"/>
                    </StackPanel>
                    <StackPanel x:Name="PanelLuz" Orientation="Vertical" Margin="6,0"
                                ToolTip="Conexión con bravo47 y con JUBA. Se enciende en rojo si alguno no responde (caído o en mantenimiento).">
                        <TextBlock Text="RED" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="10"/>
                        <Grid Width="56" Height="56">
                            <Image Source="Assets/luz_apagada.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="ImgLuzRoja" Source="Assets/luz_roja.png" Stretch="Uniform" Opacity="0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock x:Name="TxtLuz" Text="–" Width="64" HorizontalAlignment="Center" TextAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== FILA 1: formulario + resultados + log ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColForm" Width="400" MinWidth="40"/>
                <ColumnDefinition x:Name="ColSplitterForm" Width="6"/>
                <ColumnDefinition Width="2*" MinWidth="200"/>
                <ColumnDefinition x:Name="ColSplitterLog" Width="6"/>
                <ColumnDefinition x:Name="ColLog" Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Formulario -->
            <Border x:Name="BorderForm" Grid.Column="0" Background="{StaticResource PanelBg}" CornerRadius="4">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock x:Name="LblConsulta" DockPanel.Dock="Left" Text="Consulta" Style="{StaticResource SectionHeader}"/>
                        <Button x:Name="BtnToggleForm" DockPanel.Dock="Left" Content="▼" Margin="8,0,0,0"
                                Style="{StaticResource SectionToggleButtonStyle}" Click="BtnToggleForm_Click"
                                ToolTip="Ocultar/mostrar el formulario"/>
                    </DockPanel>
                    <DockPanel x:Name="FormContenido">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Área" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbGrupo" SelectionChanged="CmbGrupo_SelectionChanged" Margin="0,0,0,8"/>
                            <TextBlock Text="Herramienta" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbHerramienta" SelectionChanged="CmbHerramienta_SelectionChanged" Margin="0,0,0,8"/>
                            <Expander x:Name="ExpDescripcion" Header="Qué hace" Foreground="{StaticResource TextDim}" Margin="0,0,0,8">
                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtDescripcion" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                             Background="Transparent" Foreground="{StaticResource TextDim}" FontSize="11"/>
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnConsultar" Content="Consultar" Style="{StaticResource ConsultarButtonStyle}"
                                    Click="BtnConsultar_Click" IsEnabled="False" ToolTip="Ejecuta la herramienta (también con Ctrl+Enter)"/>
                            <Button x:Name="BtnLimpiar" Content="Limpiar" Click="BtnLimpiar_Click"
                                    ToolTip="Vacía los campos y deja los valores por defecto"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PanelCampos"/>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="SplitterForm" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- Resultados -->
            <Border x:Name="BorderResultados" Grid.Column="2" Background="#FFF2EDE1" CornerRadius="4">
                <DockPanel Margin="10">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="BtnAtras" Content="◀ Atrás" Click="BtnAtras_Click" IsEnabled="False" Margin="0,0,6,4"
                                ToolTip="Volver al resultado anterior"/>
                        <Button x:Name="BtnFragAnt" Content="◀" Click="BtnFragAnt_Click" IsEnabled="False" Margin="0,0,2,4"
                                ToolTip="Fragmento anterior del texto"/>
                        <TextBlock x:Name="TxtFragmento" Text="Fragmento –" Foreground="#FF3A3A3A" VerticalAlignment="Center" Margin="4,0,4,4"/>
                        <Button x:Name="BtnFragSig" Content="▶" Click="BtnFragSig_Click" IsEnabled="False" Margin="0,0,10,4"
                                ToolTip="Fragmento siguiente del texto"/>
                        <Button x:Name="BtnPagAnt" Content="◀" Click="BtnPagAnt_Click" IsEnabled="False" Margin="0,0,2,4"
                                ToolTip="Página anterior de resultados"/>
                        <TextBlock x:Name="TxtPagina" Text="Página –" Foreground="#FF3A3A3A" VerticalAlignment="Center" Margin="4,0,4,4"/>
                        <Button x:Name="BtnPagSig" Content="▶" Click="BtnPagSig_Click" IsEnabled="False" Margin="0,0,10,4"
                                ToolTip="Página siguiente de resultados"/>
                        <ToggleButton x:Name="TglJson" Content="{}{ } JSON" Click="TglJson_Click" Margin="0,0,6,4"
                                      ToolTip="Ver la respuesta cruda del servidor"/>
                        <Button x:Name="BtnLimpiarResultados" Content="Limpiar resultados" Click="BtnLimpiarResultados_Click"
                                Margin="0,0,6,4" ToolTip="Borrar los resultados y el historial de Atrás"/>
                        <Button x:Name="BtnVerificarSeleccion" Content="Verificar cita seleccionada" Click="BtnVerificarSeleccion_Click"
                                Margin="0,0,6,4"
                                ToolTip="Seleccioná con el mouse un pasaje de un resultado y verificalo contra el texto oficial"/>
                    </WrapPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="BtnBuscarPanel" DockPanel.Dock="Right" Content="Buscar en el resultado" Click="BtnBuscarPanel_Click"
                                Margin="6,0,0,0" ToolTip="Buscar en todo el resultado; si tiene fragmentos, en todos ellos"/>
                        <TextBlock x:Name="TxtBuscarEstado" DockPanel.Dock="Right" Foreground="#FF3A3A3A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="TxtBuscarPanel" KeyDown="TxtBuscarPanel_KeyDown" VerticalContentAlignment="Center"
                                 ToolTip="Palabra o frase a buscar dentro del resultado (Enter para buscar, vacío para ver todo)"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtTituloResultado" DockPanel.Dock="Top" Foreground="#FF1F4E63" FontWeight="SemiBold"
                               FontSize="14" TextWrapping="Wrap" Margin="2,0,0,8" Text="Elegí una herramienta, completá los campos y pulsá Consultar."/>
                    <Grid>
                        <ScrollViewer x:Name="ScrollResultados" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PanelResultados"/>
                        </ScrollViewer>
                        <TextBox x:Name="TxtJson" Visibility="Collapsed" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 Background="White" Foreground="Black" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="SplitterLog" Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- Log -->
            <Border x:Name="BorderLog" Grid.Column="4" Background="#FF0E1016" CornerRadius="4">
                <DockPanel x:Name="PanelLog" Margin="12">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Log" Style="{StaticResource SectionHeader}"/>
                        <Button x:Name="BtnToggleLog" DockPanel.Dock="Left" Content="▼" Margin="8,0,0,0"
                                Style="{StaticResource SectionToggleButtonStyle}" Click="BtnToggleLog_Click"
                                ToolTip="Ocultar/mostrar panel de Log"/>
                        <Button x:Name="BtnDesacoplarLog" DockPanel.Dock="Right" Content="Desacoplar"
                                FontSize="11" Padding="6,1" VerticalAlignment="Center" Margin="0"
                                Click="BtnDesacoplarLog_Click"
                                ToolTip="Pasar el Log a una ventana aparte (por ejemplo, en otro monitor). Al cerrarla vuelve aquí."/>
                        <Button x:Name="BtnLimpiarLog" DockPanel.Dock="Right" Content="Limpiar"
                                FontSize="11" Padding="6,1" VerticalAlignment="Center"
                                Click="BtnLimpiarLog_Click" ToolTip="Vaciar el Log"/>
                    </DockPanel>
                    <RichTextBox x:Name="TxtLog" DockPanel.Dock="Top" Margin="0,8,0,0"
                                 BorderThickness="0" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===================== FILA 2: botones ===================== -->
        <Border x:Name="BorderBotones" Grid.Row="2" Background="{StaticResource PanelBg}"
                CornerRadius="4" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Exportar como" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,8,0"/>
                <RadioButton x:Name="RbTxt" Content="TXT" GroupName="Formato" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="RbDocx" Content="DOCX" GroupName="Formato" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="BtnExportar" Content="Exportar resultado" Click="BtnExportar_Click"
                        ToolTip="Guarda el resultado que se está viendo, con la consulta que lo produjo"/>
                <Button x:Name="BtnCopiarResultado" Content="Copiar resultado" Click="BtnCopiarResultado_Click"
                        ToolTip="Copia al portapapeles el resultado que se está viendo"/>

                <Border Width="1" Background="{StaticResource PanelBorder}" Margin="6,2"/>

                <Button x:Name="BtnReglas" Content="Reglas de uso del servidor" Click="BtnReglas_Click"
                        ToolTip="Las instrucciones que publica bravo47 para citar y verificar"/>
                <Button x:Name="BtnSitio" Content="Sitio de bravo47" Click="BtnSitio_Click"
                        ToolTip="Abre https://mcp.bravo47.com en el navegador"/>

                <Border Width="1" Background="{StaticResource PanelBorder}" Margin="6,2"/>

                <Button x:Name="BtnConfiguracion" Width="40" Height="40" Padding="6" Margin="10,0,0,0"
                        Click="BtnConfiguracion_Click" ToolTip="Configuración">
                    <Image x:Name="ImgConfiguracion" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
